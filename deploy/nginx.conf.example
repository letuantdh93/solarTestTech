# Optional TLS reverse proxy in front of port 2112. When enabled set COOKIE_SECURE=true.
server {
  listen 443 ssl http2;
  server_name exam.example.vn;
  ssl_certificate     /etc/ssl/certs/exam.crt;
  ssl_certificate_key /etc/ssl/private/exam.key;
  client_max_body_size 6m;
  location / {
    proxy_pass http://127.0.0.1:2112;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
  }
}
