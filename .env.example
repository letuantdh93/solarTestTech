# ── Solar PV Examination Platform ──
NODE_ENV=development
PORT=2112
HOST=0.0.0.0
# PostgreSQL of this app (docker compose service "db"). Host port = DB_PORT; it must match the port in DATABASE_URL.
# Default 5544 so it does not clash with another PostgreSQL already using 5432.
DB_PORT=5544
POSTGRES_PASSWORD=solar_dev_pw
DATABASE_URL=postgresql://solar:solar_dev_pw@127.0.0.1:5544/solar_exam?schema=public
SESSION_SECRET=change-me-to-64-hex-chars
SESSION_TTL_HOURS=12
COOKIE_SECURE=false
UPLOAD_DIR=./uploads
# Seed admin password (change after first login)
SEED_ADMIN_PASSWORD=ChangeMe@2025
# AI (Phase 6) – leave empty to disable
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
